<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    :root { --bg:#0f1115; --card:#181b22; --fg:#e6e8ee; --muted:#9aa3b2; --ok:#3fb950; --err:#f85149; --accent:#4c8dff; }
    @media (prefers-color-scheme: light) { :root { --bg:#f4f5f7; --card:#fff; --fg:#1b1f24; --muted:#5b6472; } }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; display:grid; place-items:center; padding:1rem;
           background:var(--bg); color:var(--fg); font:16px/1.5 system-ui, sans-serif; }
    .card { background:var(--card); padding:2rem 2.5rem; border-radius:14px; max-width:28rem; width:100%;
            text-align:center; box-shadow:0 10px 30px rgb(0 0 0 / .2); }
    .icon { width:3rem; height:3rem; margin:0 auto 1rem; border-radius:50%; display:grid; place-items:center;
            font-size:1.5rem; color:#fff; }
    .ok  .icon { background:var(--ok); }
    .err .icon { background:var(--err); }
    h1 { margin:0 0 .5rem; font-size:1.4rem; }
    p  { margin:.25rem 0; color:var(--muted); }
    code { font-size:.8em; opacity:.6; }
    .btn { display:inline-block; margin-top:1.25rem; padding:.6rem 1.2rem; border-radius:8px;
           background:var(--accent); color:#fff; text-decoration:none; }
  </style>
</head>
<body>
  <main class="card {{ kind }}">
    {% block content %}{% endblock %}
  </main>
</body>
</html>
