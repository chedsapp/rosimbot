<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{{ title }}</title>
		<style>
			:root {
				--bg: #141414;
				--fg: #e6e8ee;
				--muted: #bebebe;
				--ok: #3fb950;
				--err: #f85149;
				--accent: #4c8dff;
			}
			@media (prefers-color-scheme: light) {
				:root {
					--bg: #f4f5f7;
					--fg: #1b1f24;
					--muted: #5b6472;
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 1rem;
				background: var(--bg);
				color: var(--fg);
				font:
					16px/1.5 system-ui,
					sans-serif;
				text-align: center;
			}
			.icon {
				display: block;
				width: 8rem;
				height: 8rem;
				margin: 0 auto 1rem;
				object-fit: contain;
			}
			h1 {
				margin: 0 0 0.5rem;
				font-size: 1.4rem;
			}
			p {
				margin: 0.25rem 0;
				color: var(--muted);
			}
			code {
				font-size: 0.8em;
				opacity: 0.6;
			}
			.btn {
				display: inline-block;
				margin-top: 1.25rem;
				padding: 0.6rem 1.2rem;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<main class="card {{ kind }}">
			{% block content %}{% endblock %}
		</main>
	</body>
</html>
